# .env.local — do NOT commit this file
DATABASE_URL=postgres://username:password@host:5432/dbname
PG_MAX_POOL=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000

# Set this in Vercel (Preview environment) so that opening the bare preview URL
# redirects to the school microsite instead of https://yatstats.com.
# Use the school's hsid slug (e.g. "hamilton") or numeric id (e.g. "5004").
# PREVIEW_DEFAULT_HSID=hamilton
