{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "installCommand": "pnpm install --frozen-lockfile && cp -rL node_modules/@sparticuz/chromium/bin ./chromium-bin",
  "crons": [
    {
      "path": "/api/cron/tbc-safe-ingest",
      "schedule": "0 10,22 * * *"
    },
    {
      "path": "/api/cron/tbc-ingest-watchdog",
      "schedule": "15 11,23 * * *"
    },
    {
      "path": "/api/cron/alpb-stats-ingest",
      "schedule": "25 9 * * *"
    },
    {
      "path": "/api/cron/indy-iscore-ingest",
      "schedule": "35 9 * * *"
