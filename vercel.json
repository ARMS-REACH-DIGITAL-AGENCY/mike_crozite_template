    {
      "path": "/api/cron/mlb-live-gamelogs",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/instagram-sync",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/contribute-photo-recovery",
