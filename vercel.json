    },
    {
      "path": "/api/cron/fan-daily-pilot",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/contribution-publish",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/social-handle-discovery",
      "schedule": "42 * * * *"
    },
    {
      "path": "/api/cron/contribution-audit-digest",
      "schedule": "15 7 * * *"
    }
  ]
}
